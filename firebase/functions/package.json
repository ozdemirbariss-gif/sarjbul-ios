{
  "name": "sarjbul-firebase-functions",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "node --check index.js && node --check channel-core.js && node --check channel-gateway.js && node --check ../../Integrations/browser-extension/popup.js && node --check ../../Integrations/browser-extension/options.js",
    "test:core": "node --test test/channel-core.test.js",
    "test:rules": "firebase emulators:exec --project demo-sarjbul --only database \"node --test test/database.rules.test.js\"",
    "deploy": "firebase deploy --only functions,database"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.2.1",
    "firebase-tools": "^14.12.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  }
}
